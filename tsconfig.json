{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src/radar/**/*.ts", "web/**/*.ts"],
  "exclude": ["node_modules", "src/radar/fetch.ts", "src/radar/profiles/fetch-profiles.ts", "src/radar/suppliers/fetch-suppliers.ts", "src/radar/polls/fetch-polls.ts", "src/radar/model/train.ts"]
}