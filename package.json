{
  "name": "eleicoes-radar",
  "private": true,
  "type": "module",
  "scripts": {
    "collect": "bun run src/pipeline.ts",
    "dashboard": "bun run src/build-dashboard.ts",
    "radar:fetch": "bun run src/radar/fetch.ts",
    "radar:build": "bun run src/radar/build.ts",
    "radar:serve": "bun run src/radar/serve.ts",
    "test": "bun test src/radar web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "css": "tailwindcss -i tailwind.css -o web/app.css --minify",
    "radar:polls": "bun run src/radar/polls/fetch-polls.ts",
    "radar:model": "bun run src/radar/model/train.ts",
    "radar:profiles": "bun run src/radar/profiles/fetch-profiles.ts",
    "radar:suppliers": "bun run src/radar/suppliers/fetch-suppliers.ts",
    "radar:panorama": "bun run src/radar/panorama.ts",
    "radar:geo": "bun run src/radar/geo/uf-map.ts",
    "radar:hist": "bun run src/radar/hist/aggregate.ts",
    "radar:mc-backtest": "bun run src/radar/mc/backtest.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "^1.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  }
}
